#!/usr/bin/env python3
"""Fake claude: logs its args, cwd and the stdin prompt to $FAKE_LOG; writes $FAKE_CLAUDE_WRITES when set."""
import json
import os
import sys

prompt = sys.stdin.read()
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps(["claude", *sys.argv[1:], os.getcwd(), prompt]) + "\n")
path = os.environ.get("FAKE_CLAUDE_WRITES")
if path:
    with open(path, "w") as f:
        f.write("review result")
print("claude done")
