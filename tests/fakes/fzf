#!/usr/bin/env python3
"""Fake fzf: logs the offered lines to $FAKE_LOG and picks the one starting with $FAKE_FZF_PICK (Esc when unset)."""
import json
import os
import sys

lines = sys.stdin.read().splitlines()
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps(["fzf", *lines]) + "\n")
pick = os.environ.get("FAKE_FZF_PICK")
chosen = [line for line in lines if pick and line.split()[0] == pick]
if not chosen:
    sys.exit(130)
print(chosen[0])
