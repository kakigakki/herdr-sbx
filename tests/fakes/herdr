#!/usr/bin/env python3
"""Fake herdr: logs each call as a JSON line to $FAKE_LOG and answers from $FAKE_HERDR (JSON)."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps(["herdr", *args]) + "\n")
state = json.load(open(os.environ["FAKE_HERDR"]))


def ok(result):
    print(json.dumps({"id": "fake", "result": result}))


if args[:2] == ["pane", "get"]:
    pane = state.get("panes", {}).get(args[2])
    if pane is None:
        print(json.dumps({"error": {"code": "pane_not_found"}}))
        sys.exit(1)
    ok({"type": "pane_info", "pane": pane})
elif args[:2] == ["tab", "create"]:
    ok({"type": "tab_created", "tab": {"tab_id": "w1:t9"}, "root_pane": {"pane_id": "w1:p9"}})
elif args[:2] == ["pane", "read"]:
    print("$ ")
elif args[:2] in (["pane", "run"], ["notification", "show"]):
    pass  # the real herdr prints nothing on success
else:
    print(json.dumps({"error": {"code": "unknown_command", "args": args}}))
    sys.exit(1)
