#!/usr/bin/env python3
"""Fake sbx: logs each call to $FAKE_LOG; `ls --json` prints $FAKE_SBX (a JSON file), or fails when absent;
`exec [-i] <name> -- <command>` runs the command locally."""
import json
import os
import subprocess
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(json.dumps(["sbx", *args]) + "\n")
path = os.environ.get("FAKE_SBX", "")
if args[:1] == ["exec"]:
    # The host stands in for the VM: same paths on both sides.
    sys.exit(subprocess.run(args[args.index("--") + 1:], stdin=sys.stdin).returncode)
if args[:2] == ["ls", "--json"] and os.path.exists(path):
    print(open(path).read())
    sys.exit(0)
print("sbx: daemon not running", file=sys.stderr)
sys.exit(1)
